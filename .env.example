# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="DATABASE_URL_SUPABASE"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="DIRECT_URL_SUPABASE"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=CLERKKEYS
CLERK_SECRET_KEY=SUPER_SECRET_CLERK_SECRET_KEY

# Comma-separated emails that are always SUPER_ADMIN (verified Clerk primary email).
# These super admins are permanent (not removable from the admin panel).
# Removing an email here makes that person a regular, UI-revocable super admin.
SUPER_ADMIN_EMAILS="owner@example.com"
